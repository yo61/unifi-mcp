{
  // Rule config lives in .markdownlint.jsonc (so editors that don't speak
  // cli2 config still pick it up). This file carries only cli2-specific
  // settings.
  //
  // node_modules/dist/coverage are a backstop for running the CLI by hand: the
  // hook only ever sees git-tracked files, whether from staged changes locally
  // or `prek run --all-files` in CI. The remaining entries are load-bearing,
  // because those files *are* tracked.
  "ignores": [
    "node_modules",
    "dist",
    "coverage",
    // Generated by release-please, which emits two blank lines between
    // sections (8x MD012). Editing it only holds until the next release
    // regenerates the file, so lint it out of scope rather than fight
    // the generator every time.
    "CHANGELOG.md",
    // /knowledge/ and /notes/ are workflow scratch spaces (handoffs,
    // debugging notes, hypotheses) — not part of the codebase's ship
    // surface, so keep them out of repo-lint scope.
    "knowledge",
    "notes",
  ],
}
